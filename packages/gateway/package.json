{
  "name": "@podbay/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "podbay-gateway": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@podbay/auth": "workspace:*",
    "@podbay/control-plane": "workspace:*",
    "@podbay/db": "workspace:*",
    "@podbay/provider": "workspace:*",
    "@podbay/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@podbay/pod-agent": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
